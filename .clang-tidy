Checks: >
  -*,
  clang-analyzer-*,
  readability-*,
  security-*,
  misc-*,
  -misc-unused-parameters,
  bugprone-*
CheckOptions:
  - { key: readability-identifier-length.IgnoredVariableNames, value: ^(l|r)$ }
  - { key: readability-identifier-length.IgnoredLoopCounterNames, value: ^(i|l|r)$ }
# WarningsAsErrors: '*'
